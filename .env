# App behavior for local development.
#
# The backend URL and app ID are NOT here. They are typed once, in
# .primitive/config.json, and reach the build through the primitiveEnv() Vite
# plugin, which defines VITE_APP_ID, VITE_API_URL, VITE_WS_URL, VITE_APP_NAME
# and VITE_PRIMITIVE_ENV for you.
#
#   primitive env list            # see the Primitive environments
#   primitive env use <name>      # point this machine at one
#
# Setting an identity key here still wins for local dev (with a warning), but
# `pnpm cf-deploy` rejects it outright — two sources of truth is the problem
# this layout removed.

# OAuth / magic-link callback URL.
# Leave as a relative path (e.g. /oauth/callback) to track whatever origin the
# app is served from — recommended, since it avoids port/host drift in dev.
# Set an absolute URL only if the callback must live on a fixed host/domain.
VITE_OAUTH_REDIRECT_URI=/oauth/callback

# Enable/disable the OAuth Proxy URL.  Typically you want this off for development and on in production.
VITE_ENABLE_AUTH_PROXY="false"

# Only show "warn" and worse logs in production
VITE_LOG_LEVEL="warn"
