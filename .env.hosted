# App behavior for hosted builds (`pnpm build:hosted`, Vite mode `hosted`),
# published with `primitive hosting deploy dist`.
#
# A hosted build carries no app identity. The app id, API URL and WebSocket
# URL come from the origin it is served on: Primitive hosting answers them at
# /__primitive/config.json, and the app reads them at start-up. Identity keys
# set here, in another .env file or in the shell are ignored in this mode, and
# so is VITE_ENABLE_AUTH_PROXY: a hosted build always signs in through the
# origin's proxy at /__primitive.
#
# Vite loads .env, .env.local, .env.hosted and .env.hosted.local for this
# mode; .env.production is not read.

# OAuth / magic-link callback URL, resolved against the hosted origin.
VITE_OAUTH_REDIRECT_URI=/oauth/callback

# Only show "warn" and worse logs.
VITE_LOG_LEVEL="warn"
