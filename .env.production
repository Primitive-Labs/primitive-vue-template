# App behavior for builds made with `--mode production` (the default `pnpm build`,
# and `pnpm cf-deploy --deploy-env production`).
#
# The backend URL and app ID are NOT here. They are typed once, in
# .primitive/config.json, and the deploy names the Primitive environment
# explicitly:
#
#   pnpm cf-deploy --deploy-env production --primitive-env prod
#
# The two are independent: --deploy-env picks this file and the wrangler
# [env.production] section; --primitive-env picks the backend/app pair.

# OAuth / magic-link callback URL.
# A relative path resolves against the deployed origin, so it works without
# hard-coding your production domain. Set an absolute URL only if the callback
# must live on a fixed host different from where the app is served.
VITE_OAUTH_REDIRECT_URI=/oauth/callback

# Enable/disable the OAuth Proxy URL.  Typically you want this off for development and on in production.
VITE_ENABLE_AUTH_PROXY="true"

# Only show "warn" and worse logs in production
VITE_LOG_LEVEL="warn"
